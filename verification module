////////////////////////////////   TRANSACTION

class transaction;
 
 bit strb; 
 rand bit we;
 rand bit [7:0] addr; 
 rand bit [7:0] wdata; 
 bit ack; 
 bit [7:0] rdata;
  
  function transaction display(input string tag);
    
    $display("[%0s] : we = %0d, addr = %0d, wdata = %0d", tag, we, addr, wdata);
    
  endfunction
  
endclass

////////////////////////   INTERFACE

interface wishbone_mem_in ;   //wmi
  
 logic clk, rst; 
 logic strb, we; 
 logic [7:0] addr; 
 logic [7:0] wdata;
 logic ack; 
 logic [7:0] rdata;
  
endinterface

///////////////////////////    GENERATOR


class generator;
  
  transaction tr;
  
  mailbox #(transaction) mbxgd;
  
  event done;
  event sconext;
  
  int count;
  
  function new(mailbox #(transaction) mbxgd);
    this.mbxgd=mbxgd;
    tr=new();
  endfunction
  
  task run();
    
    repeat(count) begin
      
      assert (tr.randomize()) else $error ("RANDOMIZATION FAILED");
      tr.display();
      mbxgd.put(tr)
      @(sconext);
    end
    ->done;
  endtask
  
endclass

////////////////////////////   DRIVER


class driver;
  
  transaction tr;
  transaction trd;
  
  mailbox #(transaction) mbxgd;
  mailbox #(transaction) mbxdm;
  
  virtual wishbone_mem_in wmi;
  
  function new(mailbox #(transaction) mbxgd, mailbox #(transaction) mbxdm);
    this.mbxgd=mbxgd;
    this.mbxdm=mbxdm;
    tr=new();
  endfunction
  
  task reset();
    
    wmi.rst <= 1'b1;
    repeat(5) @(posedge wmi.clk);
    wmi.rst <= 1'b0;
    $display("[DRV] : ---------------RESET DONE------------------");
    
  endtask
  
  
  task run();
    
    forever begin
      
      mbxgd.get(tr);
      
      if(tr.we==1'b1) begin  //write
        
        mbxdm.put(trd);
        wmi.we <= 1'b1;     // apply write
        wmi.strb <= 1'b1;
        wmi.addr <= tr.addr;
        wmi.wdata <= tr.wdata;
        @(negedge wmi.ack);
        wmi.we <= 1'b0;
        wmi.strb <= 1'b0;
        wmi.addr <= 8'b0;
		wmi.wdata <= 8'b0;
        
      end else begin    // read
        
        mbxdm.put(trd);
        wmi.we <= 1'b0;
        wmi.strb <= 1'b1;
        wmi.addr <= tr.addr;
        @(negedge wmi.ack);
        wmi.we <= 1'b0;
        wmi.strb <= 1'b0;
        wmi.addr <= 8'b0;
        
      end
      
    end
    
  endtask
  
endclass

/////////////////////     MONITOR


class monitor;
  
  transaction tr;
  transaction trd;
  
  mailbox #(transaction) mbxms;
  mailbox #(transaction) mbxdm;
  
  virtual wishbone_mem_in wmi;
  
  function new(mailbox #(transaction) mbxms, mailbox #(transaction) mbxdm);
    this.mbxms=mbxms;
    this.mbxdm=mbxdm;
    tr=new();
  endfunction
  
  task run();
    
    mbxdm.get(trd);
    
    if(trd.we == 1'b1)  begin     //write
      
      tr.we <= trd.we;
      tr.strb <= trd.strb;
      tr.addr <= trd.addr;
      tr.data <= trd.data;
      tr.ack <= wmi.ack
      mbxms.put(tr);
      
    end else begin        // read
      
      tr.we <= trd.we;
      tr.strb <= trd.strb;
      tr.addr <= trd.addr;
      tr.rdata <= wmi.rdata;
      tr.ack <= wmi.ack;
      mbxms.put(tr);
      
    end
    
  endtask
  
endclass

